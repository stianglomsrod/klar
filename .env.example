# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STUDENT_CODE_PEPPER=replace-with-at-least-32-random-characters
PILOT_ENABLED=true

# Archived or deferred features (must stay disabled for the pilot)
FEATURE_SMART_IMPORT_AI=false
NEXT_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_LEGACY_2X=false
