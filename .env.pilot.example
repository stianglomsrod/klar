# Runtime
PILOT_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-eea-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STUDENT_CODE_PEPPER=replace-with-at-least-32-random-characters

# Keep the first school pilot deliberately narrow
NEXT_PUBLIC_FEATURE_LEGACY_2X=false
NEXT_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_SMART_IMPORT_AI=false

# Used only while running npm run pilot:bootstrap-owner locally
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_DISPLAY_NAME=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Used only while running npm run pilot:remove-student locally
PILOT_STUDENT_ID=
CONFIRM_DELETE_STUDENT_ID=
